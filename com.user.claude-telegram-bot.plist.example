<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.claude-telegram-bot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/jakuna/Projects/claude-telegram-bot/run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/jakuna/Projects/claude-telegram-bot</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!-- launchd-Sessions erben die Shell-Env NICHT — Credentials hier explizit
       setzen, sonst startet der SDK-Subprozess ohne Auth (401).
       KOSTENREGEL (s. CLAUDE.md): Abo-Token verwenden (claude setup-token),
       NIEMALS ANTHROPIC_API_KEY — der würde jede Nutzung extra abrechnen. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>__DEIN_HOME_z.B._/Users/jakuna__</string>
    <key>CLAUDE_CODE_OAUTH_TOKEN</key>
    <string>__HIER_DEIN_ABO_TOKEN_sk-ant-oat…__</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/jakuna/Projects/claude-telegram-bot/logs/bot.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/jakuna/Projects/claude-telegram-bot/logs/bot.err.log</string>

  <!-- Crash-Loop-Schutz: bei wiederholten Crashes mindestens 30s warten -->
  <key>ThrottleInterval</key>
  <integer>30</integer>
</dict>
</plist>
