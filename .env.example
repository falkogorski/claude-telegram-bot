# Token vom BotFather (https://t.me/BotFather → /newbot)
TELEGRAM_BOT_TOKEN=

# Komma-getrennte Liste der erlaubten Telegram-User-IDs.
# Deine eigene ID kriegst du, indem du dem Bot /whoami schickst
# (er antwortet auch ohne Whitelist-Eintrag mit deiner ID).
# WICHTIG: ohne mindestens eine ID startet der Bot nicht.
ALLOWED_USER_IDS=

# --- Anthropic-Auth (Abo-Weg, EMPFOHLEN — kein API-Key nötig) ---
# Long-lived Token aus `claude setup-token` am angemeldeten Gerät.
# Auf dem VPS: in /etc/claude-telegram-bot.env (root, chmod 600) eintragen.
# NIEMALS in den Chat kopieren!
CLAUDE_CODE_OAUTH_TOKEN=

# ⚠️  ANTHROPIC_API_KEY bewusst NICHT gesetzt.
# Wenn API-Key UND CLAUDE_CODE_OAUTH_TOKEN gesetzt sind, bevorzugt das SDK den Key —
# damit läuft der Traffic gegen die bezahlte API statt das Abo (💰 Kostenfalle!).
# Nur setzen, wenn explizit bezahlte API-Calls gewünscht sind (z.B. Batch-Jobs).

# --- Modell-Auswahl ---
# Default: sonnet (gute Balance Qualität/Kosten)
# Optionen: opus | sonnet | haiku
CLAUDE_MODEL=sonnet

# Arbeitsverzeichnis, in dem Claude Code Dateien sieht/bearbeitet.
# Default: ~ (dein Home-Verzeichnis)
CLAUDE_WORKDIR=

# --- Pfade ---
# Memory-Verzeichnis (CLAUDE.md/Memory-Dateien).
# Default (Mac): ~/.claude/projects/-Users-jakuna/memory
# Default (VPS): via CLAUDE_MEMORY_DIR setzen, z.B. /home/claudebot/.claude/memory
CLAUDE_MEMORY_DIR=

# Verzeichnis für Konversations-Logs (Markdown-Tagesfiles).
# Mac: auf iCloud zeigen, z.B. ~/Library/Mobile Documents/com~apple~CloudDocs/Claude-Logs
# VPS: lokales Verzeichnis, z.B. /home/claudebot/claude-logs
CONVERSATION_LOG_DIR=

# --- Speech-to-Text (Sprachnachrichten) ---
# whisper_cpp = lokal via whisper.cpp (default, kostenlos)
# off         = Sprachnachrichten werden abgelehnt
STT_BACKEND=whisper_cpp

# Pfad zum Whisper-Modell.
# Modelle (Qualität/Größe): tiny ~75MB, base ~145MB, small ~480MB, medium ~1.5GB
# Download: https://huggingface.co/ggerganov/whisper.cpp/tree/main
# Empfehlung VPS: medium (bessere Qualität bei Anglizismen/gemischtem Deutsch-Englisch)
WHISPER_MODEL_PATH=

# Sprache der Sprachnachrichten (ISO-Code). Default: de
VOICE_LANGUAGE=de

# --- TTS (Text-to-Speech) ---
# Stimme für edge-tts. Default: de-DE-KatjaNeural
TTS_VOICE=de-DE-KatjaNeural

# --- Ausgabekanal ---
# Telegram-Chat-ID des Ablage-/Ausgabekanals (für PDFs, Videos, Recherchen).
# Leer = nur Bot-Chat, kein separater Ausgabekanal.
OUTPUT_CHANNEL_ID=

# --- Datei-Uploads ---
# Ordner, in den hochgeladene Dateien (Fotos, Videos, Dokumente) gespeichert werden.
# Default: ~/Downloads/claude-uploads
UPLOAD_DIR=
