# Token vom BotFather (https://t.me/BotFather → /newbot)
TELEGRAM_BOT_TOKEN=

# Komma-getrennte Liste der erlaubten Telegram-User-IDs.
# Deine eigene ID kriegst du, indem du dem Bot /whoami schickst
# (er antwortet auch ohne Whitelist-Eintrag mit deiner ID).
# WICHTIG: ohne mindestens eine ID startet der Bot nicht.
ALLOWED_USER_IDS=

# Arbeitsverzeichnis, in dem Claude Code Dateien sieht/bearbeitet.
# Default: ~ (dein Home-Ordner)
CLAUDE_WORKDIR=

# --- Anthropic-Auth: IMMER Abo-Token, NIE API-Key (Kostenregel, s. CLAUDE.md) ---
# Abo-Token erzeugen mit: claude setup-token  (läuft über das Max-Abo, kostenfrei)
# ACHTUNG: Ein gesetzter ANTHROPIC_API_KEY hätte Vorrang und würde JEDE Nutzung
# extra über die bezahlte API abrechnen — hier und systemweit NICHT setzen!
CLAUDE_CODE_OAUTH_TOKEN=

# --- Speech-to-Text (Sprachnachrichten) ---
# whisper_cpp = lokal via whisper.cpp (default, kostenlos, läuft auf M-Chip)
# off         = Sprachnachrichten werden abgelehnt
# openai      = Stub, noch nicht implementiert
STT_BACKEND=whisper_cpp

# Pfad zum Whisper-Modell. Default: ./models/ggml-small.bin
# Andere Modelle (Qualität/Größe): tiny ~75MB, base ~145MB, small ~480MB,
# medium ~1.5GB, large ~3GB. Download von
# https://huggingface.co/ggerganov/whisper.cpp/tree/main
WHISPER_MODEL_PATH=

# Sprache der Sprachnachrichten (ISO-Code). Default: de
VOICE_LANGUAGE=de
